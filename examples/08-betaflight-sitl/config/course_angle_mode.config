# Betaflight 2026.6.2 SITL course configuration.
# Applied once with: betaflight_SITL.elf --config course_angle_mode.config

mixer QUADX
map AETR1234

# AUX1: arm. AUX2: Angle self-level mode.
aux 0 0 0 1700 2100
aux 1 1 0 1700 2100

# Losing the 50 Hz virtual RC stream must stop the motors.
set failsafe_procedure = DROP

save
