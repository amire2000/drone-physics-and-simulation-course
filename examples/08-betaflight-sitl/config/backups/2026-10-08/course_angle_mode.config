# Betaflight 2026.6.2 SITL course configuration.
# Applied once with: betaflight_SITL.elf --config course_angle_mode.config

mixer QUADX
map AETR1234

# ! Module 08 yaw stabilization: match the course URDF reaction-torque signs.
# The bare SITL build defaults to OFF; the Gazebo gyro convention requires ON.
set yaw_motors_reversed = ON
# Course motor lag is 50 ms; bound yaw response for this light inertia model.
set p_yaw = 10
# A nonzero inner I caused sustained yaw oscillations in the disturbance check.
set i_yaw = 0
# RC yaw comes from a feedback controller; transmitter feedforward adds chatter.
set f_yaw = 0

# AUX1: arm. AUX2: Angle self-level mode.
aux 0 0 0 1700 2100
aux 1 1 0 1700 2100

# Losing the 50 Hz virtual RC stream must stop the motors.
set failsafe_procedure = DROP

save
