<?xml version="1.0"?>
<robot name="anatomy_drone">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.65"/>
      <inertia ixx="0.00348" ixy="0" ixz="0" iyy="0.00348" iyz="0" izz="0.00396"/>
    </inertial>
    <visual><geometry><box size="0.16 0.16 0.05"/></geometry><material name="body"><color rgba="0.12 0.22 0.40 1"/></material></visual>
    <collision><geometry><box size="0.16 0.16 0.05"/></geometry></collision>
  </link>
  <link name="motor_marker"><inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial><visual><geometry><sphere radius="0.03"/></geometry><material name="motor"><color rgba="0.1 0.65 1 1"/></material></visual></link>
  <joint name="motor_marker_joint" type="fixed"><parent link="base_link"/><child link="motor_marker"/><origin xyz="0.12 0.12 0"/></joint>
</robot>
